{
  "schema_version": 1,
  "title": "iPhone Use 合成场景评测",
  "privacy": "所有应用、记录、金额、订单 ID、bundle ID 与会话名均为合成 fixture；不含历史用户数据。",
  "provenance": "参考 2026-10-06 镜像复盘的 18 个子用例形状；不是历史成绩复制，也不表示新插件已实测通过。",
  "execution": "场景规范供人工 / agent forward test 使用；JSON 本身不会操作设备。自动 mock 测试不能证明真实 App 无副作用。",
  "readiness_checks": [
    {
      "id": "R01",
      "scenario": "全新 Mac / iPhone",
      "acceptance": [
        "doctor 指明实际依赖缺项",
        "用户完成信任与开发模式",
        "仅在 status、session、viewport 与当前观察有效时 READY"
      ]
    },
    {
      "id": "R02",
      "scenario": "已有可用 WDA",
      "acceptance": [
        "复用现有 session / Runner / 转发",
        "不为新任务重复 build"
      ]
    },
    {
      "id": "R03",
      "scenario": "Personal Team 开发 App 配额满",
      "acceptance": [
        "指出 3 apps/device 限制",
        "不自动删除已有 App",
        "等待用户处理后恢复并重新 READY"
      ]
    },
    {
      "id": "R04",
      "scenario": "签名 / profile 到期",
      "acceptance": [
        "按当前日志识别签名原因",
        "重新 build/start",
        "不把端口开放当完成"
      ]
    },
    {
      "id": "R05",
      "scenario": "USB 断开 / Runner 退出",
      "acceptance": [
        "分层识别连接与进程",
        "恢复后新的 READY 证据",
        "旧坐标 observation 不复用"
      ]
    },
    {
      "id": "R06",
      "scenario": "多设备与作者配置迁移",
      "acceptance": [
        "选择用户目标设备",
        "不硬编码作者 UDID / Team ID",
        "运行资料仅本机保存"
      ]
    }
  ],
  "scoring": {
    "dimensions": [
      {
        "name": "完成度",
        "weight": 40
      },
      {
        "name": "证据核验",
        "weight": 25
      },
      {
        "name": "效率",
        "weight": 15
      },
      {
        "name": "自主性",
        "weight": 10
      },
      {
        "name": "副作用控制",
        "weight": 10
      }
    ],
    "scale": "每项 0 至 5 分；任务未交付不能仅因 HTTP 成功打满分。",
    "measurement": "部署、预检、业务、报告生成分别记录；HTTP、UI 动作、工具调用与墙钟分开。",
    "stop_conditions": [
      "用户取消",
      "不确定写入先只读核对",
      "工具失败 / uncertain",
      "重复无进展",
      "达工具有界上限"
    ],
    "status": "未执行；每次运行独立记录环境、证据、结果和耗时。"
  },
